<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Roblox Studio</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #232527; /* Gris oscuro típico de Roblox */
            color: #f5f5f5;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        footer {
            border-top: 2px solid #555;
            margin-top: 50px;
            padding: 20px 0;
            text-align: center;
            color: #b8b8b8;
        }

        .table {
            color: #f5f5f5;
        }
    </style>
</head>
<body>
    <nav class="navbar mb-4 shadow" style="background-color: #111214; border-bottom: 3px solid #ffffff; padding: 15px 0;">
        <div class="container" style="display: flex; align-items: center; justify-content: flex-start;">

            <div style="margin-right: 40px;">
                @Html.ActionLink("⬛ Roblox App", "Index", "Home", new { area = "" }, new { style = "color: white; font-size: 1.5rem; text-decoration: none; font-weight: bold; letter-spacing: 1px;" })
            </div>

            <div>
                <ul style="display: flex; flex-direction: row; list-style-type: none; margin: 0; padding: 0; gap: 25px;">
                    <li>
                        @Html.ActionLink("Inicio", "Index", "Home", new { area = "" }, new { style = "color: #e2e2e2; text-decoration: none; font-weight: bold; font-size: 1.1rem;" })
                    </li>
                    <li>
                        @Html.ActionLink("Avatars", "Index", "Avatars", new { area = "" }, new { style = "color: #e2e2e2; text-decoration: none; font-weight: bold; font-size: 1.1rem;" })
                    </li>
                    <li>
                        @Html.ActionLink("Items", "Index", "Items", new { area = "" }, new { style = "color: #e2e2e2; text-decoration: none; font-weight: bold; font-size: 1.1rem;" })
                    </li>
                </ul>
            </div>

        </div>
    </nav>

    <div class="container body-content">
        @RenderBody()
        <hr style="border-color: #444;" />
        <footer>
            <p>&copy; @DateTime.Now.Year - Examen Roblox - Creado en Studio</p>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>