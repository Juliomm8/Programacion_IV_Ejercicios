<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Torneo de las Artes Marciales</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        footer {
            border-top: 4px solid #00529b; 
            margin-top: 50px;
            padding: 20px 0;
            text-align: center;
            font-weight: bold;
            color: #333;
        }
    </style>
</head>
<body>
    <nav class="navbar mb-4 shadow" style="background-color: #ff6a00; border-bottom: 4px solid #00529b; padding: 15px 0;">
        <div class="container" style="display: flex; align-items: center; justify-content: flex-start;">

            <div style="margin-right: 40px;">
                @Html.ActionLink("🐉 Dragon Ball App", "Index", "Home", new { area = "" }, new { style = "color: white; font-size: 1.5rem; text-decoration: none; font-weight: bold; text-shadow: 2px 2px 4px rgba(0,0,0,0.5);" })
            </div>

            <div>
                <ul style="display: flex; flex-direction: row; list-style-type: none; margin: 0; padding: 0; gap: 25px;">
                    <li>
                        @Html.ActionLink("Inicio", "Index", "Home", new { area = "" }, new { style = "color: white; text-decoration: none; font-weight: bold; font-size: 1.1rem; text-shadow: 1px 1px 2px rgba(0,0,0,0.5);" })
                    </li>
                    <li>
                        @Html.ActionLink("Guerreros", "Index", "Guerreros", new { area = "" }, new { style = "color: white; text-decoration: none; font-weight: bold; font-size: 1.1rem; text-shadow: 1px 1px 2px rgba(0,0,0,0.5);" })
                    </li>
                    <li>
                        @Html.ActionLink("Técnicas", "Index", "Tecnicas", new { area = "" }, new { style = "color: white; text-decoration: none; font-weight: bold; font-size: 1.1rem; text-shadow: 1px 1px 2px rgba(0,0,0,0.5);" })
                    </li>
                </ul>
            </div>

        </div>
    </nav>

    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - DarkSky Studios - ¡Hola, somos Alisson Armas, Samuel Cobo, Julio Mera, Amelia Povea, Jeremy Tomaselly!</p>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>