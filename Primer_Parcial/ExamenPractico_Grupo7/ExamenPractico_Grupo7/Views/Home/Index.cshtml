@{
    ViewBag.Title = "Panel de Control";
}

<div class="jumbotron p-4 p-md-5 rounded shadow-sm mb-4 text-center" style="background-color: #00529b; border: 3px solid #ff6a00;">
    <div class="col-md-12 px-0 mx-auto">
        <h1 class="display-4 font-italic" style="font-weight: bold; text-shadow: 2px 2px 4px rgba(0,0,0,0.7); color: #ffce00;">Examen Práctico de los Grandiosos Grupo 7</h1>
        <p class="lead my-3 text-white" style="font-weight: bold; color: white;">Administra a los guerreros Z y sus habilidades para defender la Tierra.</p>
    </div>
</div>

<div class="row">
    <div class="col-12 mb-5">
        <h3 style="color: #ff6a00; font-weight: bold;">⭐ Lista de Guerreros</h3>
        <div class="table-responsive shadow-sm" style="border: 2px solid #ff6a00; border-radius: 5px;">
            <table class="table table-hover bg-white mb-0 align-middle">
                <thead style="background-color: #ff6a00; color: white;">
                    <tr>
                        <th style="width: 25%;">Nombre</th>
                        <th style="width: 20%;">Raza</th>
                        <th style="width: 20%;">Nivel de Poder</th>
                        <th style="width: 20%;">Transformación</th>
                        <th style="width: 15%;" class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in ViewBag.Guerreros)
                    {
                        <tr>
                            <td><strong>@g.Nombre</strong></td>
                            <td>@g.Raza</td>
                            <td><span class="badge p-2" style="background-color: #ffce00; color: black; font-size: 0.9em;">@g.NivelPoder</span></td>
                            <td><span class="badge bg-danger p-2">@g.Transformacion</span></td>
                            <td class="text-center">
                                @Html.ActionLink("✍️", "Edit", "Guerreros", new { id = g.Id }, new { @title = "Editar", @class = "text-decoration-none mx-1 fs-5" })
                                @Html.ActionLink("🔍", "Details", "Guerreros", new { id = g.Id }, new { @title = "Detalles", @class = "text-decoration-none mx-1 fs-5" })
                                @Html.ActionLink("❌", "Delete", "Guerreros", new { id = g.Id }, new { @title = "Borrar", @class = "text-decoration-none mx-1 fs-5" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="col-12">
        <h3 style="color: #00529b; font-weight: bold;">💥 Lista de Técnicas</h3>
        <div class="table-responsive shadow-sm" style="border: 2px solid #00529b; border-radius: 5px;">
            <table class="table table-hover bg-white mb-0 align-middle">
                <thead style="background-color: #00529b; color: white;">
                    <tr>
                        <th style="width: 25%;">Nombre de Técnica</th>
                        <th style="width: 20%;">Tipo</th>
                        <th style="width: 20%;">Nivel de Daño</th>
                        <th style="width: 20%;">Guerrero Asociado</th>
                        <th style="width: 15%;" class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in ViewBag.Tecnicas)
                    {
                        <tr>
                            <td><strong>@t.NombreTecnica</strong></td>
                            <td>@t.Tipo</td>
                            <td><span class="badge bg-dark p-2">Daño: @t.NivelDano</span></td>
                            <td><span class="badge p-2" style="background-color: #00529b; color: white;">@t.Guerrero.Nombre</span></td>
                            <td class="text-center">
                                @Html.ActionLink("✍️", "Edit", "Tecnicas", new { id = t.Id }, new { @class = "text-decoration-none mx-1 fs-5" })
                                @Html.ActionLink("🔍", "Details", "Tecnicas", new { id = t.Id }, new { @class = "text-decoration-none mx-1 fs-5" })
                                @Html.ActionLink("❌", "Delete", "Tecnicas", new { id = t.Id }, new { @class = "text-decoration-none mx-1 fs-5" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>