<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Sailor Moon Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root {
            --sailor-pink: #ffb7d5;
            --sailor-dark-pink: #d81b60;
            --sailor-purple: #b19cd9;
            --sailor-gold: #ffd700;
        }

        body {
            background-color: #fffafa; /* Un blanco rosado muy suave */
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .navbar {
            background-color: var(--sailor-dark-pink) !important;
            border-bottom: 3px solid var(--sailor-gold);
        }

        .navbar-brand, .nav-link {
            color: white !important;
            font-weight: bold;
        }

        footer {
            border-top: 2px solid var(--sailor-pink);
            margin-top: 50px;
            padding: 20px 0;
            text-align: center;
        }

        .btn-primary {
            background-color: var(--sailor-dark-pink);
            border: none;
        }

            .btn-primary:hover {
                background-color: #ad1457;
            }
    </style>
</head>
<body>
    <nav class="navbar mb-3 shadow" style="background-color: #d81b60; border-bottom: 3px solid #ffd700; padding: 15px 0;">
        <div class="container" style="display: flex; align-items: center; justify-content: flex-start;">

            <div style="margin-right: 40px;">
                @Html.ActionLink("🌙 Sailor Moon App", "Index", "Home", new { area = "" }, new { style = "color: white; font-size: 1.5rem; text-decoration: none; font-weight: bold;" })
            </div>

            <div>
                <ul style="display: flex; flex-direction: row; list-style-type: none; margin: 0; padding: 0; gap: 25px;">
                    <li>
                        @Html.ActionLink("Inicio", "Index", "Home", new { area = "" }, new { style = "color: white; text-decoration: none; font-weight: bold; font-size: 1.1rem;" })
                    </li>
                    <li>
                        @Html.ActionLink("Senshis", "Index", "SailorSenshis", new { area = "" }, new { style = "color: white; text-decoration: none; font-weight: bold; font-size: 1.1rem;" })
                    </li>
                    <li>
                        @Html.ActionLink("Aliados", "Index", "Aliados", new { area = "" }, new { style = "color: white; text-decoration: none; font-weight: bold; font-size: 1.1rem;" })
                    </li>
                </ul>
            </div>

        </div>
    </nav>

    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - Examen Sailor Moon - Por el poder del Prisma Lunar</p>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>