<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Mundo Champiñón</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f4f4f4;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        footer {
            border-top: 4px solid #43b047; /* Verde tubería */
            margin-top: 50px;
            padding: 20px 0;
            text-align: center;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <nav class="navbar mb-4 shadow" style="background-color: #e52521; border-bottom: 4px solid #fbd000; padding: 15px 0;">
        <div class="container" style="display: flex; align-items: center; justify-content: flex-start;">

            <div style="margin-right: 40px;">
                @Html.ActionLink("🍄 Mario Bros App", "Index", "Home", new { area = "" }, new { style = "color: white; font-size: 1.5rem; text-decoration: none; font-weight: bold; text-shadow: 1px 1px 2px black;" })
            </div>

            <div>
                <ul style="display: flex; flex-direction: row; list-style-type: none; margin: 0; padding: 0; gap: 25px;">
                    <li>
                        @Html.ActionLink("Inicio", "Index", "Home", new { area = "" }, new { style = "color: white; text-decoration: none; font-weight: bold; font-size: 1.1rem; text-shadow: 1px 1px 1px black;" })
                    </li>
                    <li>
                        @Html.ActionLink("Personajes", "Index", "Personajes", new { area = "" }, new { style = "color: white; text-decoration: none; font-weight: bold; font-size: 1.1rem; text-shadow: 1px 1px 1px black;" })
                    </li>
                    <li>
                        @Html.ActionLink("Enemigos", "Index", "Enemigos", new { area = "" }, new { style = "color: white; text-decoration: none; font-weight: bold; font-size: 1.1rem; text-shadow: 1px 1px 1px black;" })
                    </li>
                </ul>
            </div>

        </div>
    </nav>

    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - Examen Mario Bros - Nivel 1-1</p>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>