@{
    ViewBag.Title = "Panel de Control";
}

<div class="jumbotron p-4 p-md-5 text-white rounded shadow-sm mb-4" style="background-color: #049cd8; border: 4px solid #000;">
    <div class="col-md-8 px-0">
        <h1 class="display-4 font-italic" style="text-shadow: 2px 2px 4px #000;">Reino Champiñón</h1>
        <p class="lead my-3" style="text-shadow: 1px 1px 2px #000;">Gestiona los héroes y las amenazas del mundo de Mario Bros.</p>
    </div>
</div>

<div class="row">
    <div class="col-12 mb-5">
        <h3 style="color: #e52521; font-weight: bold;">⭐ Lista de Personajes</h3>
        <div class="table-responsive shadow-sm" style="border: 2px solid #e52521; border-radius: 5px;">
            <table class="table table-hover bg-white mb-0">
                <thead style="background-color: #e52521; color: white;">
                    <tr>
                        <th>Nombre</th>
                        <th>Reino</th>
                        <th>Nivel de Poder</th>
                        <th>Habilidad Especial</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in ViewBag.Personajes)
                    {
                        <tr>
                            <td><strong>@p.Nombre</strong></td>
                            <td>@p.Reino</td>
                            <td><span class="badge" style="background-color: #fbd000; color: black;">@p.NivelPoder</span></td>
                            <td>@p.HabilidadEspecial</td>
                            <td class="text-center">
                                @Html.ActionLink("✍️", "Edit", "Personajes", new { id = p.Id }, new { @title = "Editar", @class = "text-decoration-none mx-1" })
                                @Html.ActionLink("🔍", "Details", "Personajes", new { id = p.Id }, new { @title = "Detalles", @class = "text-decoration-none mx-1" })
                                @Html.ActionLink("❌", "Delete", "Personajes", new { id = p.Id }, new { @title = "Borrar", @class = "text-decoration-none mx-1" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="col-12">
        <h3 style="color: #43b047; font-weight: bold;">🐢 Lista de Enemigos</h3>
        <div class="table-responsive shadow-sm" style="border: 2px solid #43b047; border-radius: 5px;">
            <table class="table table-hover bg-white mb-0">
                <thead style="background-color: #43b047; color: white;">
                    <tr>
                        <th>Enemigo</th>
                        <th>Tipo</th>
                        <th>Nivel de Dificultad</th>
                        <th>Personaje Asociado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in ViewBag.Enemigos)
                    {
                        <tr>
                            <td><strong>@e.NombreEnemigo</strong></td>
                            <td>@e.Tipo</td>
                            <td><span class="badge bg-dark">@e.NivelDificultad</span></td>
                            <td><span class="badge" style="background-color: #049cd8;">@e.Personaje.Nombre</span></td>
                            <td class="text-center">
                                @Html.ActionLink("✍️", "Edit", "Enemigos", new { id = e.Id }, new { @class = "text-decoration-none mx-1" })
                                @Html.ActionLink("🔍", "Details", "Enemigos", new { id = e.Id }, new { @class = "text-decoration-none mx-1" })
                                @Html.ActionLink("❌", "Delete", "Enemigos", new { id = e.Id }, new { @class = "text-decoration-none mx-1" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>