@model StarWarsApiWebApp.Models.Personaje

<style>
    body {
        background: #050505;
    }

    .details-container {
        max-width: 700px;
        margin: 40px auto;
        padding: 35px;
        border-radius: 22px;
        background: radial-gradient(circle at top left, rgba(255, 232, 31, 0.18), transparent 40%), linear-gradient(180deg, #111827 0%, #050505 100%);
        color: white;
        border: 1px solid rgba(255, 232, 31, 0.35);
        box-shadow: 0 0 30px rgba(255, 232, 31, 0.18);
    }

    .details-title {
        color: #ffe81f;
        text-align: center;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-weight: bold;
        margin-bottom: 25px;
        text-shadow: 0 0 12px rgba(255, 232, 31, 0.8);
    }

    .character-icon {
        width: 90px;
        height: 90px;
        margin: 0 auto 25px auto;
        border-radius: 50%;
        background: linear-gradient(135deg, #ffe81f, #f59e0b);
        color: #111827;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 40px;
        font-weight: bold;
        box-shadow: 0 0 20px rgba(255, 232, 31, 0.45);
    }

    .info-box {
        background: rgba(255, 255, 255, 0.06);
        padding: 15px 20px;
        border-radius: 14px;
        margin-bottom: 12px;
        border-left: 4px solid #ffe81f;
    }

        .info-box strong {
            color: #ffe81f;
        }

    .back-btn {
        display: inline-block;
        margin-top: 25px;
        padding: 10px 22px;
        border-radius: 25px;
        background: #ffe81f;
        color: #111827;
        font-weight: bold;
        text-decoration: none;
        transition: 0.3s;
    }

        .back-btn:hover {
            background: white;
            color: black;
            text-decoration: none;
        }
</style>

<div class="details-container">
    <div class="character-icon">
        @Model.name.Substring(0, 1)
    </div>

    <h1 class="details-title">@Model.name</h1>

    <div class="info-box">
        <strong>Altura:</strong> @Model.height cm
    </div>

    <div class="info-box">
        <strong>Peso:</strong> @Model.mass kg
    </div>

    <div class="info-box">
        <strong>Color de cabello:</strong> @Model.hair_color
    </div>

    <div class="info-box">
        <strong>Color de piel:</strong> @Model.skin_color
    </div>

    <div class="info-box">
        <strong>Color de ojos:</strong> @Model.eye_color
    </div>

    <div class="info-box">
        <strong>Año de nacimiento:</strong> @Model.birth_year
    </div>

    <div class="info-box">
        <strong>Género:</strong> @Model.gender
    </div>

    @Html.ActionLink("Volver a la lista", "Index", null, new { @class = "back-btn" })
</div>