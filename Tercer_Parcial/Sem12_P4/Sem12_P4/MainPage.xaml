<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sem12_P4.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="SuperHéroes"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <CollectionView ItemsSource="{Binding Heroes}"
                            SelectedItem="{Binding SelectedHero, Mode=TwoWay}">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="18" ColumnDefinitions="100,*">

                            <Image Source="{Binding Image}"
                                   Aspect="AspectFill"
                                   HeightRequest="80"
                                   WidthRequest="100"
                                   VerticalOptions="Center" />

                            <VerticalStackLayout Grid.Column="1" Padding="10,0">

                                <Label Text="{Binding Name}"
                                       FontSize="18"
                                       FontAttributes="Bold" />

                                <Label Text="{Binding Power}"
                                       FontSize="14"
                                       TextColor="Gray" />

                            </VerticalStackLayout>

                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Frame BorderColor="CadetBlue"
                   CornerRadius="12"
                   Padding="10">

                <VerticalStackLayout Spacing="6">

                    <Label Text="Héroe seleccionado:"
                           FontAttributes="Bold" />

                    <Label Text="{Binding SelectedHero.Name}"
                           FontSize="22"
                           FontAttributes="Bold" />

                    <Label Text="{Binding SelectedHero.Power}"
                           FontSize="14"
                           TextColor="Gray" />
                    <Image Source="{Binding SelectedHero.Image}"
                           Aspect="AspectFill"
                           HeightRequest="150"
                           WidthRequest="200"
                           VerticalOptions="Center" />

                </VerticalStackLayout>

            </Frame>

            <Button Text="Mostrar Detalles"
                    Command="{Binding ShowHeroCommand}"
                    HeightRequest="46" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>