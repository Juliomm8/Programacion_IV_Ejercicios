<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FarmaciaVirtual_Grupo7.MenuPage"
             Title="Catálogo de medicinas"
             BackgroundColor="#F4F7F5"
             Shell.BackgroundColor="#0F766E"
             Shell.ForegroundColor="White"
             Shell.TitleColor="White">

    <Grid RowDefinitions="Auto,*,Auto,Auto"
          BackgroundColor="#F4F7F5">

        <Frame Grid.Row="0"
               Margin="15,12,15,5"
               Padding="15,12"
               BackgroundColor="#CCFBF1"
               BorderColor="#5EEAD4"
               CornerRadius="14"
               HasShadow="False">
            <VerticalStackLayout Spacing="3">
                <Label Text="Selecciona tus medicinas"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#0F766E"
                       HorizontalOptions="Center" />
                <Label Text="Usa los botones + y - para indicar cuántas unidades deseas comprar"
                       FontSize="12"
                       TextColor="#334155"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Frame>

        <CollectionView x:Name="MedicinasCollectionView"
                        Grid.Row="1"
                        Margin="10,5"
                        ItemSizingStrategy="MeasureAllItems">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="5">
                        <Frame BackgroundColor="#FFFFFF"
                               BorderColor="#CBD5E1"
                               CornerRadius="14"
                               Padding="16"
                               HasShadow="True">
                            <VerticalStackLayout Spacing="10">

                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding Nombre}"
                                               TextColor="#0F172A"
                                               FontSize="17"
                                               FontAttributes="Bold" />
                                        <Label Text="{Binding Descripcion}"
                                               FontSize="12"
                                               TextColor="#64748B" />
                                    </VerticalStackLayout>

                                    <Frame Grid.Column="1"
                                           Padding="10,6"
                                           BackgroundColor="#DCFCE7"
                                           BorderColor="#86EFAC"
                                           CornerRadius="10"
                                           HasShadow="False">
                                        <Label Text="{Binding Precio, StringFormat='${0:F2}'}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="#166534" />
                                    </Frame>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="10">
                                    <Label Grid.Column="0"
                                           Text="{Binding Stock, StringFormat='Stock disponible: {0} unidades'}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#475569"
                                           VerticalOptions="Center" />

                                    <Label Grid.Column="1"
                                           Text="{Binding StockRestante, StringFormat='Quedarán: {0}'}"
                                           FontSize="12"
                                           TextColor="#0F766E"
                                           VerticalOptions="Center" />
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto,Auto,Auto,*"
                                      ColumnSpacing="12"
                                      HorizontalOptions="Fill">

                                    <Button Grid.Column="1"
                                            Text="−"
                                            FontSize="22"
                                            FontAttributes="Bold"
                                            BackgroundColor="#DC2626"
                                            TextColor="White"
                                            WidthRequest="52"
                                            HeightRequest="48"
                                            CornerRadius="12"
                                            Padding="0"
                                            Clicked="OnDecrementClicked"
                                            CommandParameter="{Binding .}" />

                                    <Frame Grid.Column="2"
                                           Padding="18,7"
                                           BackgroundColor="#E0F2FE"
                                           BorderColor="#38BDF8"
                                           CornerRadius="12"
                                           HasShadow="False"
                                           MinimumWidthRequest="145">
                                        <VerticalStackLayout Spacing="0">
                                            <Label Text="SELECCIONADOS"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="#0369A1"
                                                   HorizontalOptions="Center" />
                                            <Label Text="{Binding Cantidad}"
                                                   FontSize="24"
                                                   FontAttributes="Bold"
                                                   TextColor="#0C4A6E"
                                                   HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Frame>

                                    <Button Grid.Column="3"
                                            Text="+"
                                            FontSize="20"
                                            FontAttributes="Bold"
                                            BackgroundColor="#16A34A"
                                            TextColor="White"
                                            WidthRequest="52"
                                            HeightRequest="48"
                                            CornerRadius="12"
                                            Padding="0"
                                            Clicked="OnIncrementClicked"
                                            CommandParameter="{Binding .}" />
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Subtotal del producto:"
                                           FontSize="13"
                                           TextColor="#475569"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Subtotal, StringFormat='${0:F2}'}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#B45309" />
                                </Grid>
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Frame Grid.Row="2"
               Margin="15,5"
               Padding="16"
               BackgroundColor="#ECFDF5"
               BorderColor="#6EE7B7"
               CornerRadius="14"
               HasShadow="False">
            <VerticalStackLayout Spacing="8">

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Unidades seleccionadas:"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />
                    <Label Grid.Column="1"
                           x:Name="lblCantidadTotal"
                           Text="0"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#0369A1" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Subtotal:"
                           TextColor="#0F172A" />
                    <Label Grid.Column="1"
                           x:Name="lblSubtotalVenta"
                           Text="$0.00"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout>
                        <Label Text="Aplicar descuento del 5%"
                               FontAttributes="Bold"
                               TextColor="#0F172A" />
                        <Label x:Name="lblEstadoDescuento"
                               Text="Disponible cuando el subtotal supere $50.00"
                               FontSize="11"
                               TextColor="#64748B" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1"
                            x:Name="switchDescuento"
                            IsEnabled="False"
                            OnColor="#0F766E"
                            ThumbColor="White"
                            Toggled="OnDescuentoToggled"
                            VerticalOptions="Center" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Descuento:"
                           TextColor="#0F172A" />
                    <Label Grid.Column="1"
                           x:Name="lblDescuentoVenta"
                           Text="-$0.00"
                           FontAttributes="Bold"
                           TextColor="#B91C1C" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="IVA (12%):"
                           TextColor="#0F172A" />
                    <Label Grid.Column="1"
                           x:Name="lblImpuestoVenta"
                           Text="$0.00"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />
                </Grid>

                <BoxView HeightRequest="1"
                         BackgroundColor="#94A3B8" />

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="TOTAL:"
                           FontSize="19"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />
                    <Label Grid.Column="1"
                           x:Name="lblTotal"
                           Text="$0.00"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#0F766E" />
                </Grid>
            </VerticalStackLayout>
        </Frame>

        <Button x:Name="btnGenerarFactura"
                Grid.Row="3"
                Text="GENERAR FACTURA"
                BackgroundColor="#0F766E"
                TextColor="White"
                FontSize="16"
                FontAttributes="Bold"
                Margin="20,8,20,16"
                HeightRequest="54"
                CornerRadius="14"
                Clicked="OnGenerarFacturaClicked" />

    </Grid>
</ContentPage>
