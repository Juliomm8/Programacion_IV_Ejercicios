<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FarmaciaVirtual_Grupo7.MainPage"
             BackgroundColor="#F4F7F5">

    <StackLayout VerticalOptions="Center" Spacing="30" Padding="20">

        <Label Text="💊" FontSize="80" HorizontalOptions="Center" />

        <Label Text="FARMACIA VIRTUAL"
               FontSize="28" FontAttributes="Bold"
               TextColor="#0F766E"
               HorizontalOptions="Center" />

        <Label Text="Sistema de Ventas"
               FontSize="16" TextColor="#475569"
               HorizontalOptions="Center" />

        <Button x:Name="btnIngresar"
                Text="INGRESAR"
                BackgroundColor="#0F766E" TextColor="White"
                FontSize="18" CornerRadius="10"
                WidthRequest="200" HeightRequest="50"
                Clicked="OnIngresarClicked" />

    </StackLayout>

</ContentPage>