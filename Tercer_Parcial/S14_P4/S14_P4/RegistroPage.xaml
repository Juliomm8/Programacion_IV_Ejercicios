<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="S14_P4.RegistroPage"
             Title="RegistroPage">
    <VerticalStackLayout Padding="20" Spacing="10">
        <Entry x:Name="nombreEntry" Placeholder="Nombre del Medicamento" />
        <Entry x:Name="precioEntry" Placeholder="Precio del Medicamento" />
        <Entry x:Name="stockEntry" Placeholder="Stock del Medicamento" />

        <Button x:Name="btnGuardar"
                Text="Guardar"
                Clicked="OnGuardarClicked"
                
            />
    </VerticalStackLayout>
</ContentPage>